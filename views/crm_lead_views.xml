<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- inherit view of Lead Form : adding the "convert to task" button -->
   <record id="crm_lead_view_form" model="ir.ui.view">
      <field name="model">crm.lead</field>
      <field name="inherit_id" ref="crm.crm_lead_view_form" />

      <field name="arch" type="xml">
         <xpath expr="(//div[@name='button_box'])[last()]" position="inside">
            <button class="oe_stat_button {{task_ready ? 'text-warning' : 'text-success'}}"
               context="{'partner_id': partner_id}" icon="fa-tasks" invisible="task_count == 0"
               name="action_view_tasks" type="object" groups="project.group_project_user">
               <div class="o_stat_info">
                  <field class="o_stat_value" name="task_count" />
                  <span class="o_stat_text">Tasks</span>
               </div>
            </button>
         </xpath>
         <field name="stage_id" position="before">
            <button class="oe_stat_button" name="%(jt_lead_task_wizard_add_task)d"
               string="Create project task" type="action" groups="project.group_project_user"/>
         </field>
      </field>
   </record>

  <record id="crm_case_form_view_opportt" model="ir.ui.view">
    <field name="name">crm.lead.oppor.inherited.crmtt</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button invisible="task_ready == False" name="action_sale_quotations_newer"
          string="New Quotation with products" type="object" groups="project.group_project_user" />
      </xpath>
    </field>
  </record>

  <record id="crm_lead_view_form" model="ir.ui.view">
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form" />
    <field name="arch" type="xml">
      <field name="tag_ids" position="after">
        <field name="client_ref" />
      </field>
    </field>
  </record>

  <record id="crm_case_tree_view_oppor" model="ir.ui.view">
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <field name="tag_ids" position="after">
        <field name="client_ref" optional="hide" />
      </field>
    </field>
  </record>

  <record id="crm_case_kanban_view_leads" model="ir.ui.view">
    <field name="inherit_id" ref="crm.crm_case_kanban_view_leads" />
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="client_ref" t-if="record.client_ref" />
      </field>
    </field>
  </record>

  <record id="crm_opportunity_partner_filter" model="ir.ui.view">
    <field name="name">crm.opportunity.partner.filter.assigned</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
    <field name="arch" type="xml">
      <field name="phone_mobile_search" position="after">
        <field name="client_ref" />
      </field>
    </field>
  </record>

</odoo>