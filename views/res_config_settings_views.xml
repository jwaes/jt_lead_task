<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jt.lead.task</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="crm" position="inside">
                <block title="Lead Tasks">
                    <setting help="Default project">
                        <field name="project_id" />
                    </setting>

                    <setting help="Task prefix">
                        <field name="task_prefix" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>